# Copy this file to ".env" (same folder as server.js) and fill in the blanks.
# No quotes, no spaces around the = sign.

# The account with this email becomes the admin (it must sign up and verify first).
ADMIN_EMAIL=salimjay40@gmail.com

# Email sending (Gmail). SMTP_PASS is a Gmail APP PASSWORD, not your normal password.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=salimjay40@gmail.com
SMTP_PASS=paste-the-16-letter-app-password-here
MAIL_FROM=Send Me Deliveries <salimjay40@gmail.com>

# Only when the server is live on the internet over HTTPS (leave commented on your own computer):
# NODE_ENV=production

# ---- Production database (Turso). Leave blank to use the local file smd.db while developing. ----
# TURSO_DATABASE_URL=libsql://your-database-your-org.turso.io
# TURSO_AUTH_TOKEN=

# ---- M-Pesa (Safaricom Daraja, STK Push). Leave blank to keep "pay on delivery" only. ----
# Get keys at https://developer.safaricom.co.ke. For real money, apply for Go Live with your Till; Safaricom then gives you the production key, secret and passkey.
# MPESA_ENV=sandbox            # "sandbox" while testing, "production" when live
# MPESA_CONSUMER_KEY=
# MPESA_CONSUMER_SECRET=
# MPESA_SHORTCODE=174379       # sandbox shortcode is 174379; live = your Paybill or Till (store) number
# MPESA_PASSKEY=               # sandbox passkey is on the Daraja "Test Credentials" page; live comes from Safaricom
# MPESA_TXN_TYPE=CustomerPayBillOnline     # use CustomerBuyGoodsOnline for a Till number
# MPESA_PARTY_B=               # only for a Till: the Till number (the shortcode is then the store/head-office number)
# MPESA_CALLBACK_BASE=https://your-public-domain.example   # public HTTPS origin Safaricom can reach (no trailing slash)
# MPESA_CALLBACK_SECRET=       # long random string (24+ chars): openssl rand -hex 24. It becomes part of the callback URL.
# MPESA_CALLBACK_IPS=          # optional: comma-separated Safaricom callback IPs to accept (needs TRUST_PROXY=1 behind a proxy)
# DEFER_MIN_GOODS=999          # goods above this (KES), from a listed shop, can be paid for after delivery through M-Pesa

# Job alerts for shippers (phone notifications). Make the pair once with:  npm run vapid
# Put both lines in Render > Environment. Keep the private key secret. Leave empty to switch alerts off.
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
# Shippers based within this many km of the pickup area get the alert (default 10)
NOTIFY_KM=10
